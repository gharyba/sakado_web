# Shared PostgreSQL database for public and admin applications.
DATABASE_URL="postgresql://sakado:replace-me@127.0.0.1:5432/sakado"
AUTH_SECRET="replace-with-at-least-32-random-characters"
SITE_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3000"
DEMO_MODE="false"
MEDIA_LOCAL_DIR="./uploads"
MEDIA_STORAGE="local"
# Only enable behind a trusted proxy which replaces X-Forwarded-For.
TRUST_PROXY="false"
# Production domain is TO BE CONFIRMED. See .env.production.example and docs/DEPLOYMENT.md.
