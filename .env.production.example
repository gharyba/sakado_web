# TEMPLATE ONLY. Do not deploy unchanged or commit a populated copy.
# Supply values through Hostinger's environment settings.
NODE_ENV="production"
DATABASE_URL=""
AUTH_SECRET=""
SITE_URL=""
# Required HTTPS origin. Shared /admin is supported when ADMIN_URL is empty.
ADMIN_URL=""
DEMO_MODE="false"
TRUST_PROXY="false"
# Only local storage exists today. These values are NOT durable on managed redeploy.
# External adapter or verified persistent storage is a staging prerequisite.
MEDIA_STORAGE="local"
MEDIA_LOCAL_DIR="./uploads"
# Optional, verified business contacts:
CONTACT_EMAIL=""
CONTACT_PHONE=""
CONTACT_ADDRESS=""
WHATSAPP_NUMBER=""
# PORT must be a process/hosting setting, not a Next.js .env setting.
# ADMIN_NAME, ADMIN_EMAIL and ADMIN_PASSWORD are one-time provisioning inputs only.
# HOME_V2_ENABLED, REGISTRATIONS_ENABLED and DIRECT_URL are not implemented.
# Operational production startup validates DATABASE_URL, AUTH_SECRET, SITE_URL,
# DEMO_MODE=false and supported storage/proxy settings. Explicit demo mode may
# start without these operational settings, but never grants admin access or content writes.
# /api/health checks DB connectivity outside demo mode; it is not a launch authorization.
