# TEMPLATE ONLY. Empty values intentionally fail startup validation.
# Next does NOT load .env.staging automatically. Supply process/provider settings.
NODE_ENV="production"
DATABASE_URL=""
AUTH_SECRET=""
SITE_URL=""
ADMIN_URL=""
DEMO_MODE="false"
# Suppresses indexing and public caching; NOT an access-control mechanism.
STAGING_MODE="true"
TRUST_PROXY="false"
# Only local adapter exists. A dedicated persistent staging path is required externally.
MEDIA_STORAGE="local"
MEDIA_LOCAL_DIR=""
# Use separate synthetic content/admin/credentials; never copy production data.
# Set PORT in the process/hosting platform, not in this file.
# ADMIN_NAME/ADMIN_EMAIL/ADMIN_PASSWORD are one-time provisioning inputs only.
# External staging additionally requires a provider/proxy access restriction.
