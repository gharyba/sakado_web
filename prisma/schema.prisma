generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum AdminRole {
  OWNER
  ADMIN
  EDITOR
}
enum RegistrationStatus {
  CLOSED
  OPEN
  FEW_PLACES
  FULL
  WAITLIST_ONLY
}
enum BookingStatus {
  PENDING
  CONFIRMED
  WAITLIST
  CANCELLED
  COMPLETED
}
enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
}

enum ContentSource {
  CONFIRMED
  DEMO
}

enum EnvironmentType {
  FOREST
  MOUNTAIN
  BEACH
  DESERT
  COUNTRYSIDE
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         AdminRole @default(EDITOR)
  lastLoginAt  DateTime?
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AdminSession[]
  auditLogs    AuditLog[]
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([adminId, expiresAt])
}

model RateLimit {
  key       String @id
  count     Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model AuditLog {
  id         String @id @default(cuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
  @@index([createdAt])
}

model EventCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  enabled     Boolean       @default(false)
  order       Int           @default(0)
  source      ContentSource @default(CONFIRMED)
  events      Event[]
}

model Event {
  id                  String              @id @default(cuid())
  slug                String              @unique
  title               String
  shortDescription    String
  description         String
  coverImage          String?
  location            String?
  startsAt            DateTime?
  endsAt              DateTime?
  duration            String?
  difficulty          String?
  price               Decimal?
  currency            String              @default("TND")
  capacity            Int?
  status              EventStatus         @default(DRAFT)
  registrationStatus  RegistrationStatus @default(CLOSED)
  registrationOpenAt  DateTime?
  registrationDeadline DateTime?
  showAvailability    Boolean @default(true)
  featured            Boolean @default(false)
  meetingTime         String?
  recommendations     String?
  conditions          String?
  recap               String?
  version             Int @default(0)
  published           Boolean             @default(false)
  source              ContentSource       @default(CONFIRMED)
  included            Json?
  excluded            Json?
  equipment           Json?
  meetingPoint        String?
  importantInfo       String?
  cancellationInfo    String?
  categoryId          String?
  category            EventCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  destinationId       String?
  destination         Destination?        @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  schedule            EventScheduleItem[]
  gallery             GalleryImage[]
  instagramMedia      InstagramMedia[]
  bookings            Booking[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  @@index([published, source, startsAt])
  @@index([status, startsAt])
}

model Booking {
  id               String @id @default(cuid())
  reference        String @unique
  idempotencyKey   String @unique
  eventId          String
  event            Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  firstName        String
  lastName         String
  email            String
  phone            String
  participantCount Int
  totalAmount      Decimal @db.Decimal(12,3)
  currency         String @default("TND")
  status           BookingStatus @default(PENDING)
  paymentStatus    PaymentStatus @default(UNPAID)
  notes            String?
  internalNote     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([eventId, status])
  @@index([email])
  @@index([createdAt])
}

model Destination {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  region      String?
  description String
  coverImage  String?
  latitude    Float?
  longitude   Float?
  difficulty  String?
  environment EnvironmentType?
  published   Boolean          @default(false)
  archived    Boolean          @default(false)
  featured    Boolean          @default(false)
  source      ContentSource    @default(CONFIRMED)
  events      Event[]
  gallery     GalleryImage[]
  instagramMedia InstagramMedia[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model EventScheduleItem {
  id          String @id @default(cuid())
  eventId     String
  event       Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  day         Int
  time        String?
  title       String
  description String?
  order       Int    @default(0)
  @@index([eventId, day, order])
}

model GalleryImage {
  id            String        @id @default(cuid())
  src           String
  alt           String
  caption       String?
  category      String?
  order         Int           @default(0)
  authorized    Boolean       @default(false)
  published     Boolean       @default(false)
  featured      Boolean       @default(false)
  source        ContentSource @default(CONFIRMED)
  eventId       String?
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  destinationId String?
  destination   Destination?  @relation(fields: [destinationId], references: [id], onDelete: SetNull)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([archived, read, createdAt])
}

model SiteSettings {
  id                      String  @id @default("main")
  content                 Json
  instagramFollowersLabel String?
  instagramPostsLabel     String?
  communityMembersLabel   String?
  updatedAt               DateTime @updatedAt
}

model SocialLink {
  id      String  @id @default(cuid())
  label   String
  url     String
  enabled Boolean @default(true)
  order   Int     @default(0)
}


enum InstagramMediaType {
  INSTAGRAM_MEDIA
  PHOTO
  VIDEO
  REEL
  CAROUSEL
}

model InstagramMedia {
  id            String @id @default(cuid())
  instagramUrl  String @unique
  title         String?
  mediaType     InstagramMediaType @default(INSTAGRAM_MEDIA)
  previewImage  String?
  eventId       String?
  event         Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  featured      Boolean @default(false)
  showOnHomepage Boolean @default(false)
  published     Boolean @default(false)
  displayOrder  Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([published, showOnHomepage, displayOrder])
  @@index([eventId])
  @@index([destinationId])
}
