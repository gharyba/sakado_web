{
  "name": "sakado-sfax",
  "version": "0.1.0",
  "private": true,
  "description": "Sakado Sfax — camping, randonnée et aventures en Tunisie",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "test:phase09": "playwright test --config playwright.phase09.config.ts",
    "test:phase09b": "playwright test --config playwright.phase09b.config.ts",
    "dev:app": "next dev --hostname 127.0.0.1",
    "dev:client": "node scripts/dev-client-demo.mjs",
    "prepare:client": "node scripts/prepare-client-demo.mjs",
    "build": "tsx scripts/check-public-media.ts && prisma generate && next build && tsx scripts/check-public-media.ts --built && node scripts/check-client-demo-build.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:motion": "playwright test --config playwright.motion.config.ts",
    "test:navigation": "playwright test --config playwright.navigation.config.ts",
    "test:hero": "playwright test --config playwright.hero.config.ts",
    "test:client": "playwright test --config playwright.client-demo.config.ts",
    "test:phase04": "playwright test --config playwright.phase04.config.ts",
    "test:phase05": "node scripts/test-phase05.mjs",
    "test:phase06": "node scripts/test-phase05.mjs --phase06",
    "test:phase10": "node scripts/test-phase05.mjs --phase10",
    "test:phase10:public": "playwright test --config playwright.phase10-public.config.ts",
    "test:ci": "tsx scripts/test-ci.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:production-env": "node scripts/check-production-startup.mjs",
    "rehearse:deployment": "node scripts/rehearse-deployment.mjs",
    "test:staging": "node scripts/rehearse-staging.mjs",
    "check:release": "node --import tsx scripts/check-release-evidence.ts",
    "test:e2e": "node --env-file=.env --import tsx tests/browser/prepare.ts && node --env-file=.env node_modules/@playwright/test/cli.js test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "admin:create": "node --env-file=.env --import tsx scripts/create-admin.ts",
    "db:local": "node scripts/local-postgres.mjs",
    "test:integration": "node --env-file=.env --import tsx tests/database.integration.ts",
    "instagram:import": "node --env-file=.env --import tsx scripts/import-instagram-media.ts",
    "start:hostinger": "node scripts/start.mjs --hostinger"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "argon2": "^0.45.1",
    "gsap": "3.15.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  }
}
